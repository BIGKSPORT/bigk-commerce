# Copy to .env.local for local use. Never commit the resulting file.
APP_URL=http://localhost:3000
# sqlite for local review; postgres for Supabase. Never expose DATABASE_URL to browsers.
DATABASE_PROVIDER=sqlite
DATABASE_PATH=data/bigk.sqlite
DATABASE_URL=
# Optional Supabase CA certificate PEM if required by your connection.
DATABASE_CA_CERT=
COMMERCE_MODE=demo
LIVE_COMMERCE_APPROVED=false
# Set to a long random value (at least 32 characters) before sharing the app.
RECEIPT_SECRET=
# Generate with npm run admin:password; copy the hash only, never the password.
ADMIN_PASSWORD_HASH=
# Stripe TEST keys first. Configure webhook at /api/webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Verified Resend domain/sender for account links and order emails.
RESEND_API_KEY=
EMAIL_FROM=

# Public Supabase connection. Database migration is still required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# BigK Club — disabled until staging review. Never enable against an unmigrated DB.
BIGK_CLUB_ENABLED=false
# Separate loyalty wait after receipt of the entire order, not the legal return window.
BIGK_CLUB_WAIT_DAYS=30

# Persistent product uploads for the Node backoffice. Back up this directory.
MEDIA_PATH=data/uploads
