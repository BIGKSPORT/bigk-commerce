{
  "name": "bigk-commerce",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/build-static-media-manifest.mjs && next build --webpack && node scripts/build-jobs.mjs && node scripts/check-payment-config.mjs",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/commerce.test.ts",
    "admin:password": "node scripts/hash-password.mjs",
    "inventory:expire": "node --import tsx scripts/expire-reservations.ts",
    "email:deliver": "node --import tsx scripts/deliver-emails.ts",
    "test:browser": "node tests/browser.mjs",
    "test:http": "node tests/http.mjs",
    "catalog:sync-images": "node --import tsx scripts/sync-product-images.ts",
    "supabase:check": "node --use-env-proxy --env-file=.env.local scripts/check-supabase.mjs",
    "test:postgres": "node tests/postgres.mjs",
    "images:optimize": "node scripts/optimize-product-images.mjs",
    "preview:build": "node scripts/build-interactive-preview.mjs",
    "test:preview": "node tests/interactive-preview.mjs",
    "club:process": "node --import tsx scripts/process-club.ts",
    "test:club": "node --import tsx tests/club.test.ts",
    "test:backoffice": "node --import tsx tests/backoffice.test.ts",
    "preview:backoffice": "node scripts/build-backoffice-review.mjs",
    "test:backoffice-browser": "node tests/backoffice-browser.mjs",
    "catalog:sync-content": "node --import tsx scripts/sync-product-content.ts",
    "catalog:import-master-staging": "node --import tsx scripts/import-master-staging.ts",
    "backoffice:staging": "node scripts/start-backoffice-staging.mjs",
    "test:media": "node --import tsx tests/media-database.test.ts",
    "test:withdrawals": "node --import tsx tests/withdrawals.test.ts",
    "test:staging": "node tests/staging-schema.mjs",
    "launch:check": "node scripts/check-launch.mjs",
    "test:dpd": "node --import tsx --test tests/dpd-preflight.test.ts",
    "test:myparcel": "node --import tsx --test tests/myparcel-costs.test.ts",
    "test:support-policy": "node --import tsx --test tests/customer-service-policy.test.ts",
    "test:support-order": "node --import tsx --test tests/customer-service-order-review.test.ts",
    "test:warehouse": "node --import tsx --test tests/warehouse-inspection.test.ts",
    "test:auth-shipping": "node tests/auth-shipping.mjs",
    "test:auth-browser": "node tests/auth-browser.mjs",
    "test:payment-journey": "node tests/payment-journey.mjs",
    "test:checkout-browser": "node tests/checkout-browser.mjs",
    "test:product-management": "node --import tsx tests/product-management.test.ts && node tests/product-management.mjs",
    "test:product-management-browser": "node tests/product-management-browser.mjs",
    "test:alpin": "node --import tsx tests/alpin-technology.test.ts && node --import tsx tests/alpin-fleece.test.ts && node --import tsx tests/alpin-fleece-commerce.ts && node tests/alpin-fleece-browser.mjs",
    "test:alpin-vest": "node --import tsx --test tests/alpin-vest-technology.test.ts && node tests/alpin-vest-technology-browser.mjs",
    "test:nano-front": "node --import tsx --test tests/nano-technology.test.ts && node tests/nano-front-browser.mjs",
    "test:self-management": "node --import tsx --test tests/self-management-media.test.ts && node tests/self-management-browser.mjs",
    "test:fleece-save": "node --import tsx --test tests/product-validation.test.ts && node tests/fleece-save-browser.mjs",
    "test:launch-safety": "node --import tsx tests/launch-safety.test.ts",
    "test:account-confirm-browser": "node tests/account-confirm-browser.mjs",
    "test:customers": "node --import tsx tests/customer-marketing.test.ts && node tests/customer-marketing-postgres.mjs",
    "test:customers-browser": "node tests/customer-marketing-browser.mjs",
    "test:b10": "node --import tsx tests/b10.test.ts && node tests/b10-browser.mjs",
    "test:care": "node --import tsx tests/care-instructions.test.tsx",
    "test:product-groups": "node --import tsx tests/product-groups.test.ts && node --import tsx tests/ribs.test.ts && node tests/product-groups-browser.mjs"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "stripe": "23.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-socket": "0.2.16",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module"
}
